<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="First-time setup 🛠"
        android:textColor="#1A237E"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="TimeWarp needs these to move your clock without root."
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- Row 1: Shizuku running -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dotShizukuRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#B0BEC5"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 · Shizuku running"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subShizukuRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="checking..."
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnShizukuRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 2: Shizuku permission -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dotShizukuPerm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#B0BEC5"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 · Shizuku permission"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subShizukuPerm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="checking..."
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnShizukuPerm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grant"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 3: overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dotOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#B0BEC5"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 · Floating bubble access"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="checking..."
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 4: battery -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dotBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#B0BEC5"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 · Ignore battery limits (optional)"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="keeps the app alive in background"
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Protect"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Row 5: notifications (API 33+, hidden until checked) -->
    <LinearLayout
        android:id="@+id/rowNotif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/dotNotif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#B0BEC5"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 · Notifications (optional)"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subNotif"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="shows the bubble's foreground notice"
                android:textColor="#777777"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNotif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSetupSkip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Skip"
            android:textAllCaps="false" />

        <Space
            android:layout_width="10dp"
            android:layout_height="0dp" />

        <Button
            android:id="@+id/btnSetupDone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:text="Done ✅"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
